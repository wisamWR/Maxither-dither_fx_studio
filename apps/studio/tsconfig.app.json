{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "./dist",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@ditherforge/core": ["../../packages/core/src"],
      "@ditherforge/core/*": ["../../packages/core/src/*"],
      "@ditherforge/hardware": ["../../packages/hardware/src"],
      "@ditherforge/hardware/*": ["../../packages/hardware/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
